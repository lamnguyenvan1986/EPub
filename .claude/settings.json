{
  "projectName": "LibriAudio",
  "projectType": "flutter",
  "filePatterns": [
    "lib/**/*.dart"
  ],
  "ignoredPatterns": [
    "build/**",
    ".dart_tool/**",
    "pubspec.lock"
  ],
  "contextFiles": [
    "CLAUDE.md",
    "docs/ARCHITECTURE.md",
    "docs/SETUP.md",
    "pubspec.yaml"
  ],
  "flutter": {
    "entryPoint": "lib/main.dart",
    "platforms": [
      "android",
      "ios",
      "web",
      "linux"
    ]
  },
  "stateManagement": "provider",
  "database": "hive",
  "keyFiles": {
    "main": "lib/main.dart",
    "bookReader": "lib/screens/book_reader_screen.dart",
    "ttsService": "lib/services/tts_service.dart",
    "storageService": "lib/services/storage_service.dart",
    "driveService": "lib/services/drive_service.dart",
    "bookProvider": "lib/providers/book_provider.dart"
  }
}
